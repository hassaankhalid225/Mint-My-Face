# =============================================================================
# Mint My Face — Backend environment (copy to .env)
# =============================================================================

# Allowed browser origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend base URL (Stripe success/cancel redirects)
FRONTEND_URL=http://localhost:3000

# One-time HD unlock per design (cents) — default 499 = $4.99
HD_PRICE_CENTS=499

# -----------------------------------------------------------------------------
# Stripe — subscriptions & plan checkout
# Dashboard: https://dashboard.stripe.com/
#
# Create Products → Prices, then paste Price IDs below.
# Pro uses subscription mode when STRIPE_PRICE_PRO is set.
#
# Webhook endpoint: POST /api/billing/webhook
# Event: checkout.session.completed
#
# Local forward:  stripe listen --forward-to localhost:8000/api/billing/webhook
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# -----------------------------------------------------------------------------
# Paddle — Merchant of Record (works in Pakistan, payout via Payoneer)
# Dashboard: https://vendors.paddle.com/  (use Sandbox first: sandbox-vendors.paddle.com)
#
# 1. Catalog → Products → create "Mint My Face — Starter" and "— Pro"
#    Add a ONE-TIME price to each ($2 and $5 USD). Copy the Price IDs (pri_...).
# 2. Developer Tools → Authentication → copy the Client-side token (test_... / live_...)
#    -> goes in Frontend/.env as NEXT_PUBLIC_PADDLE_CLIENT_TOKEN
# 3. Developer Tools → Notifications → New destination
#    URL: https://<your-backend>/api/billing/paddle/webhook
#    Events: transaction.completed
#    Copy the destination's Secret key (pdl_ntfset_...) below.
# 4. Checkout → Website approval: add your domain (e.g. localhost for sandbox).
#
# Webhook endpoint: POST /api/billing/paddle/webhook
# -----------------------------------------------------------------------------
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PRO=

# Google OAuth (copy same values to Frontend/.env for login button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
