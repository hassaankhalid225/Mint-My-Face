# =============================================================================
# Mint My Face — Backend environment (copy to .env)
# =============================================================================

# Allowed browser origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend base URL (Stripe success/cancel redirects)
FRONTEND_URL=http://localhost:3000

# One-time HD unlock per design (cents) — default 499 = $4.99
HD_PRICE_CENTS=499

# -----------------------------------------------------------------------------
# Stripe — subscriptions & plan checkout
# Dashboard: https://dashboard.stripe.com/
#
# Create Products → Prices, then paste Price IDs below.
# Pro uses subscription mode when STRIPE_PRICE_PRO is set.
#
# Webhook endpoint: POST /api/billing/webhook
# Event: checkout.session.completed
#
# Local forward:  stripe listen --forward-to localhost:8000/api/billing/webhook
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Google OAuth (copy same values to Frontend/.env for login button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
