// Prisma — switch provider anytime (postgresql, mysql, etc.)
// Dev: SQLite. Production: set DATABASE_URL to Postgres/MySQL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // e.g. file:./dev.db or postgresql://user:pass@host/db
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  googleId     String?  @unique
  image        String?
  plan         String   @default("free")
  mintDay      String?
  mintCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
